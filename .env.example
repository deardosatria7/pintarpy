# ------------------------------------------------------------------
# Database — Postgres bersama dengan finance-zenio.
# Container-nya didefinisikan di finance-zenio/docker-compose.yml
# (jalankan: cd ../finance-zenio && docker compose up -d db)
#
# Dari host  : @localhost:5432
# Dari docker: @shared-postgres:5432
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zenio_pintarpy"

# ------------------------------------------------------------------
# better-auth
# BETTER_AUTH_SECRET WAJIB sama persis dengan milik finance-zenio
# supaya sesi bisa dipakai bersama. Generate: openssl rand -base64 32
# ------------------------------------------------------------------
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email admin yang boleh menulis blog post
NEXT_PUBLIC_ADMIN_EMAIL=""
